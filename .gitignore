# SOFIA — BankPortal .gitignore

# Python venv
.sofia/venv/
.sofia-venv/
.sofia/backups/
__pycache__/
*.pyc

# Node
node_modules/
npm-debug.log

# Build outputs
target/
dist/
build/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
!.sofia/sofia.log

# Paquetes de release SOFIA (binarios — no versionar)
sofia-deploy-v*.zip

# Playwright (added by QA Step 6 Sprint 26)
apps/frontend-portal/test-results/
apps/frontend-portal/playwright-results.json
apps/frontend-portal/.angular/
apps/frontend-portal/dist/

# SOFIA QA evidence dir contains compiled logs only (intentionally tracked)
# Keep docs/quality/evidence/ tracked

# SOFIA temporales
.sofia/tmp/
.sofia/*.bak-*
# Backups locales de ficheros raíz (defensa pre-edit; el historial canónico es git)
CLAUDE.md.bak*

.sofia/sofia-config.json.bak-*
